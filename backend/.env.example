NODE_ENV=production
PORT=4010
HOST=127.0.0.1
API_BASE_URL=https://api.marqueeflow.com
ADMIN_ORIGIN=https://admin.marqueeflow.com
WEBSITE_ORIGIN=https://marqueeflow.com
JWT_SECRET=change-me-in-production-use-32-plus-chars
# First Super Admin (production only — do not use demo values on VPS)
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_ROLE=super_admin
# JSON file store path (default: backend/data/runtime/store.json)
STORE_PATH=
# MySQL schema in src/db/schema.sql — wire DATABASE_URL when migrating
DATABASE_URL=mysql://marqueeflow:change-me@127.0.0.1:3306/marqueeflow
